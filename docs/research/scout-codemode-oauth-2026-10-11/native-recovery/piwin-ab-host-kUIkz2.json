              "arguments": {
                "code": "const fs = await import('fs');\nconst path = 'experiment-data/orders.json';\nconst raw = fs.readFileSync(path, 'utf8');\nconst data = JSON.parse(raw);\nconst rows = data.rows || data;\nconst filtered = rows.filter(r => \n  r.status === 'paid' && \n  r.currency === 'CNY' && \n  (r.region === 'cn-east' || r.region === 'cn-north') && \n  r.grossCents >= 1000\n);\nconst bySku = new Map();\nfor (const r of filtered) {\n  const sku = r.sku;\n  let agg = bySku.get(sku);\n  if (!agg) {\n    agg = { sku, count: 0, quantity: 0, netCents: 0 };\n    bySku.set(sku, agg);\n  }\n  agg.count += 1;\n  agg.quantity += r.quantity;\n  agg.netCents += (r.grossCents - r.refundCents);\n}\nconst top = [...bySku.values()]\n  .sort((a, b) => b.netCents - a.netCents || (a.sku < b.sku ? -1 : a.sku > b.sku ? 1 : 0))\n  .slice(0, 5);\nreturn {\n  matchedCount: filtered.length,\n  top,\n  totalRows: rows.length,\n  sampleKeys: rows[0] ? Object.keys(rows[0]) : []\n};"
