              "arguments": {
                "code": "const raw = await tools.read_file({ path: 'experiment-data/orders.json' });\nconst data = JSON.parse(raw);\nconst rows = data.rows;\nconst filtered = rows.filter(r => \n  r.status === 'paid' && \n  r.currency === 'CNY' && \n  (r.region === 'cn-east' || r.region === 'cn-north') && \n  r.grossCents >= 1000\n);\nconst bySku = new Map();\nfor (const r of filtered) {\n  const sku = r.sku;\n  let agg = bySku.get(sku);\n  if (!agg) {\n    agg = { sku, count: 0, quantity: 0, netCents: 0 };\n    bySku.set(sku, agg);\n  }\n  agg.count += 1;\n  agg.quantity += Number(r.quantity);\n  agg.netCents += (Number(r.grossCents) - Number(r.refundCents));\n}\nconst top = [...bySku.values()]\n  .sort((a, b) => b.netCents - a.netCents || (a.sku < b.sku ? -1 : a.sku > b.sku ? 1 : 0))\n  .slice(0, 5);\nreturn { matchedCount: filtered.length, top };"
