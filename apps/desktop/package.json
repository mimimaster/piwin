{
  "name": "@piwin/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "dev:tauri": "tauri dev --config src-tauri/tauri.conf.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "tauri build --config src-tauri/tauri.conf.json",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"lint ok (desktop)\"",
    "tauri": "tauri",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@piwin/artifact": "workspace:*",
    "@piwin/contracts": "workspace:*",
    "@piwin/doc-rag": "workspace:*",
    "@piwin/flashcards": "workspace:*",
    "@piwin/host-client": "workspace:*",
    "@piwin/host-transport": "workspace:*",
    "@piwin/pet": "workspace:*",
    "@piwin/session": "workspace:*",
    "@piwin/theme": "workspace:*",
    "@piwin/ui-kit": "workspace:*",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/math": "1.0.2",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.12",
    "framer-motion": "12.42.2",
    "katex": "0.16.47",
    "lucide-react": "1.25.0",
    "mermaid": "^11.16.0",
    "modelicons": "0.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.4.1",
    "streamdown": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "vitest": {
    "environment": "happy-dom",
    "setupFiles": [
      "./src/setupTests.ts"
    ]
  }
}
