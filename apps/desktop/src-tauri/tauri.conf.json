{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "piwinwin",
  "version": "0.0.0",
  "identifier": "app.piwinwin.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm exec vite --port 1420 --strictPort",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "pnpm exec tsc -b && pnpm exec vite build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 700,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self' data:; frame-src 'self' blob: data:; child-src 'self' blob: data:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/.piwin/media/**",
            "$HOME/.piwin/pets/**",
            "$HOME/.codex/pets/**",
            "$APPDIR/**",
            "$RESOURCE/**"
          ],
          "deny": [
            "$HOME/.piwin/credentials/**",
            "$HOME/.ssh/**",
            "$HOME/.aws/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
