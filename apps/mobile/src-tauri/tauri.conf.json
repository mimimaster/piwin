{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piwin Mobile",
  "version": "0.0.0",
  "identifier": "app.piwin.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Piwin Mobile",
        "width": 390,
        "height": 844,
        "resizable": false,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  }
}
