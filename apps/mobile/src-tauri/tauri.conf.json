{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "piwin shell",
  "version": "1.0.0",
  "identifier": "app.piwin.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": ".."
    },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "piwin shell",
        "width": 390,
        "height": 844,
        "resizable": false,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self' data:; frame-src 'self' blob: data: about:"
    }
  },
  "bundle": {
    "iOS": {
      "developmentTeam": "F47G63A8DM",
      "bundleVersion": "1.0.0.9",
      "template": "src-tauri/ios-project.yml",
      "infoPlist": "Info.plist"
    }
  }
}
