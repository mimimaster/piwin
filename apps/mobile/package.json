{
  "name": "@piwin/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1421 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:tauri": "tauri dev --config src-tauri/tauri.conf.json",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"lint ok (mobile)\""
  },
  "dependencies": {
    "@piwin/artifact": "workspace:*",
    "@piwin/contracts": "workspace:*",
    "@piwin/host-client": "workspace:*",
    "@piwin/host-transport": "workspace:*",
    "@piwin/ui-kit": "workspace:*",
    "@piwin/voice": "workspace:*",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/math": "1.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "katex": "0.16.47",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "4.4.1",
    "streamdown": "2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "vitest": {
    "environment": "happy-dom"
  }
}
