{
  "name": "@piwin/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "piwin-gateway": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts serve",
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@piwin/contracts": "workspace:*",
    "@piwin/host-transport": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
