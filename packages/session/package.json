{
  "name": "@piwin/session",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./classify-plan": {
      "types": "./src/classify-plan.ts",
      "import": "./src/classify-plan.ts",
      "default": "./src/classify-plan.ts"
    },
    "./derive-default-name": {
      "types": "./src/derive-default-name.ts",
      "import": "./src/derive-default-name.ts",
      "default": "./src/derive-default-name.ts"
    },
    "./fork-session-name": {
      "types": "./src/fork-session-name.ts",
      "import": "./src/fork-session-name.ts",
      "default": "./src/fork-session-name.ts"
    },
    "./session-display-name": {
