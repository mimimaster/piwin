    "@piwin/mcp": "workspace:*",
    "@piwin/media": "workspace:*",
    "@piwin/notes": "workspace:*",
    "@piwin/pet": "workspace:*",
    "@piwin/process": "workspace:*",
    "@piwin/project": "workspace:*",
    "@piwin/session": "workspace:*",
    "@piwin/speech": "workspace:*",
    "@piwin/skills": "workspace:*",
    "@piwin/theme": "workspace:*",
    "@piwin/tools-web": "workspace:*",
